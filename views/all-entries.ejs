
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Entries</title>
</head>

<body>
    <%- include('./partials/navbar') %>

    <h1>All Entries</h1>

    <% for (let oneEntry of entry) { %>
        <h2>
            <%= oneEntry.title %>
        </h2>

        <p>
            <%= oneEntry.entryBody %>
        </p>

        <% if (oneEntry.owner && oneEntry.owner._id.equals(user._id)) { %>
            <form action="/entries/<%= oneEntry._id %>?_method=DELETE" method="POST">
                <button type="submit">Delete</button>
            </form>

            <form action="/entries/<%= oneEntry._id %>/edit" method="GET">
                <button type="submit">Edit</button>
            </form>
        <% } %>
    <% } %>

</body>
</html>
